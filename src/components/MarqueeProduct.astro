---
import type { CollectionEntry } from 'astro:content';

interface Props {
  product: CollectionEntry<'products'>;
  tagline?: string;
}

const { product, tagline } = Astro.props;
const { title, description, cover, link, status, price } = product.data;
const href = `/products/${product.id}/`;
---

<section class="marquee" aria-labelledby="marquee-title">
  <div class="marquee-body">
    <span class="marquee-eyebrow">// marquee</span>
    <h3 class="marquee-title" id="marquee-title">
      <a href={href}>{title}</a>
    </h3>
    {tagline && <p class="marquee-tagline">{tagline}</p>}
    {description && <p class="marquee-desc">{description}</p>}
    <div class="marquee-meta">
      {price && <span class="marquee-price">{price}</span>}
      {status && <span class="marquee-status">{status}</span>}
    </div>
    <div class="marquee-actions">
      {link && <a class="marquee-cta" href={link} rel="noopener">Get it &rarr;</a>}
      <a class="marquee-secondary" href={href}>How it works</a>
    </div>
  </div>
  <a class="marquee-media" href={href} aria-hidden="true" tabindex="-1">
    {cover && <img src={cover} alt="" loading="eager" />}
  </a>
</section>

<style>
  /* Single column on purpose: the content well is ~690px, so a two-column
     split left the text at ~230px and wrapped it three words to a line. */
  .marquee {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2rem;
    padding: 1.5rem;
    border: 1px solid var(--color-rule);
    border-radius: 12px;
    background: var(--color-bg-2);
  }

  .marquee-body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    min-width: 0;
  }

  .marquee-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-xs);
    letter-spacing: var(--tracking-caps-wide);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .marquee-title {
    font-size: var(--fs-hero);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }
  .marquee-title a {
    color: inherit;
    text-decoration: none;
  }
  .marquee-title a:hover { color: var(--color-link); }

  .marquee-tagline {
    font-size: var(--fs-h3);
    margin: 0;
  }

  .marquee-desc {
    color: var(--color-muted);
    margin: 0;
    max-width: 58ch;
  }

  .marquee-meta {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-sm);
  }
  .marquee-price { font-weight: 600; }
  .marquee-status { color: var(--color-signal); }

  .marquee-actions {
    margin-top: 0.4rem;
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-sm);
  }

  .marquee-cta {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    background: var(--color-accent);
    color: #FFFCF0;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    transition: transform 0.18s ease, filter 0.18s ease;
  }
  .marquee-cta:hover {
    transform: translateY(-2px);
    filter: brightness(1.06);
  }

  .marquee-secondary { color: var(--color-link); }

  /* The border does the work: a defined edge stops the warm cream reading as a
     dingy patch of the cool grey panel. */
  .marquee-media {
    display: block;
    border-radius: 10px;
    overflow: hidden;
    border: 3px solid var(--color-shot-frame);
    line-height: 0;
    transition: transform 0.18s ease, border-color 0.18s ease;
  }
  .marquee-media:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent);
  }
  .marquee-media img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 640px) { /* --bp-md */
    .marquee { padding: 1.15rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-cta, .marquee-media { transition: none; }
    .marquee-cta:hover, .marquee-media:hover { transform: none; }
  }
</style>
