---
const items = [
  {
    label: 'shipping',
    value: '<a href="/products/engram/">Engram</a> — spaced-repetition flashcards',
  },
  { label: 'reading', value: 'The Art of Doing Science and Engineering (Hamming)<br>Abaddon&rsquo;s Gate (Corey)' },
  { label: 'building', value: '<a href="/projects/ekko-pai/">EKKO (my PAI)</a>, <a href="/mcp/">Custom MCP Servers</a>' },
  { label: 'working with', value: 'teams building agent-native products' },
];
---
<aside class="currently" aria-label="Currently">
  <div class="currently-header">
    <span class="currently-tag">// currently</span>
  </div>
  <ul class="currently-list">
    {items.map((item) => (
      <li>
        <span class="currently-label">{item.label}</span>
        <span class="currently-value" set:html={item.value} />
      </li>
    ))}
  </ul>
</aside>
