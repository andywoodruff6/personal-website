---
import { getCollection } from 'astro:content';

const tools = await getCollection('tools', ({ data }) => import.meta.env.DEV || !data.draft);

// Lead with the count only once the list is long enough to be the point.
// Below the threshold a bare number undersells it; above, the number IS the pitch.
const COUNT_THRESHOLD = 8;
const trackingValue =
  tools.length >= COUNT_THRESHOLD
    ? `<a href="/tools/">${tools.length} tools built and written up &rarr;</a>`
    : '<a href="/tools/">the tools I build, written up &rarr;</a>';

const items = [
  {
    label: 'making',
    value:
      'Trellis Fieldbook &mdash; one agentic-powered, self-contained system for solo wedding planners, replacing the docs-and-spreadsheets sprawl',
  },
  { label: 'learning', value: 'how companies build products in the agentic era' },
  { label: 'tracking', value: trackingValue },
  {
    label: 'looking for',
    value:
      'a full-time role building the tooling that makes businesses run more efficiently &mdash; <a href="/connect/">get in touch</a>',
  },
];
---
<aside class="currently" aria-label="Currently">
  <div class="currently-header">
    <span class="currently-tag">// currently</span>
  </div>
  <ul class="currently-list">
    {items.map((item) => (
      <li>
        <span class="currently-label">{item.label}</span>
        <span class="currently-value" set:html={item.value} />
      </li>
    ))}
  </ul>
</aside>
